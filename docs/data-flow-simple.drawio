        <mxCell id="s22" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;" parent="1" source="s8" target="s9" edge="1">
          <mxGeometry relative="1" as="geometry" />
