        <mxCell id="s23" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;" parent="1" source="s9" target="s11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s24" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" parent="1" source="s9" target="s12" edge="1">
