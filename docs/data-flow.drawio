<mxfile host="app.diagrams.net"><diagram id="apguardian-dfd" name="AP Guardian data flow"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:20px'&gt;AP Guardian - invoice data flow, checks and agent actions&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="-50" width="1900" height="40" as="geometry"/></mxCell><mxCell id="c3" value="(3) EMAIL GATE - runs before any agent is involved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1300" height="330" as="geometry"/></mxCell><mxCell id="c4" value="Vendor&lt;br&gt;email + PDF invoice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="110" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Amazon SES&lt;br&gt;receipt rule&lt;br&gt;(invoices@ address)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="150" width="120" height="70" as="geometry"/></mxCell><mxCell id="c6" value="S3 landing&lt;br&gt;raw/" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="335" y="145" width="100" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ingest_email Lambda&lt;/b&gt; - checks, in order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="475" y="50" width="340" height="40" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;1. Sender authentication:&lt;/b&gt; top-most Authentication-Results header only (DMARC pass, or SPF + DKIM pass). Headers lower down can be forged, so they are ignored.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. SES verdicts:&lt;/b&gt; spam and virus verdicts must be PASS.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Allow-list:&lt;/b&gt; sender domain must belong to an APPROVED vendor (Vendors table). The vendor is taken from the authenticated sender, never from the invoice text.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Attachments:&lt;/b&gt; at least one PDF, max 3 PDFs, 10 MB each." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="475" y="95" width="340" height="235" as="geometry"/></mxCell><mxCell id="c9" value="All checks pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="855" y="150" width="110" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;S3 quarantine/&lt;/b&gt;&lt;br&gt;Never reaches an agent. Reason logged (QUARANTINED). Any processing error also lands here (fails closed)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="50" width="300" height="75" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;S3 invoice PDFs&lt;/b&gt;&lt;br&gt;tagged with authenticated vendor_id, sender, email body key" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="300" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;S3 email bodies&lt;/b&gt;&lt;br&gt;plain-text body, max 8,000 chars" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="245" width="300" height="70" as="geometry"/></mxCell><mxCell id="c13" value="SMTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="raw email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="S3 event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="(2) EXTRACTION AND TRIGGER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="1300" height="200" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;extract_invoice Lambda&lt;/b&gt;&lt;br&gt;(S3 event on PDF upload)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="440" width="220" height="80" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Textract AnalyzeExpense&lt;/b&gt;&lt;br&gt;amounts, PO no., dates, confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="440" width="180" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Invoices table&lt;/b&gt;&lt;br&gt;vendor_id, PO no., amount_cents, confidence, pdf key. Status EXTRACTED." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="430" width="210" height="100" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;invoke_agent Lambda&lt;/b&gt;&lt;br&gt;DynamoDB stream INSERT. Sends ONLY the invoice_id, never invoice text." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="230" height="80" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Fails closed&lt;/b&gt;&lt;br&gt;Agent error, timeout, guardrail stop, or a run that ends with no decision opens a human exception." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="250" height="100" as="geometry"/></mxCell><mxCell id="c27" value="S3 event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c11" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="PDF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="fields" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;startArrow=block;endArrow=none;" edge="1" parent="1" source="c26" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="AGENTCORE MANAGED HARNESS - 4 agents, 4 IAM roles, no shell / browser / memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="1300" height="350" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;(4) Identity&lt;/b&gt;: each agent has its own IAM role (SigV4) and an allowedTools list. Agents only ever receive an invoice_id, so no vendor text sits in a prompt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="430" height="95" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;SUPERVISOR agent&lt;/b&gt;&lt;br&gt;Tool: delegate only. No data or payment tools. Orders the work, passes only invoice_id, PO number and short facts, and writes the final report: PAID / SENT FOR HUMAN REVIEW / STOPPED." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="650" width="320" height="120" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;(5) Hooks&lt;/b&gt;: Bedrock Guardrail scans the input and EVERY tool result (prompt-attack filter, master-data-change topic filter). A hit stops the run (hook_stopped) and the invoice goes to human review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="650" width="450" height="95" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;INTAKE agent&lt;/b&gt; - read_invoice, one call.&lt;br&gt;Reports vendor, total (cents), invoice no., PO no., date.&lt;br&gt;&lt;b&gt;Red flags:&lt;/b&gt; missing PO; amount missing or confidence &amp;lt; 80; bank details on invoice; urgency or pressure language; change-of-payment requests; text instructing an AI; vendor name not fitting vendor_id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="390" height="150" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;MATCHING agent&lt;/b&gt; - read_invoice + lookup_po.&lt;br&gt;&lt;b&gt;MATCH only if all true:&lt;/b&gt;&lt;br&gt;- PO exists and is OPEN&lt;br&gt;- PO vendor = authenticated invoice vendor&lt;br&gt;- vendor status APPROVED&lt;br&gt;- invoice amount &amp;lt;= PO remaining balance&lt;br&gt;Otherwise NO MATCH. Cannot pay or approve." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="800" width="390" height="150" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;PAYMENT agent&lt;/b&gt; - pay_invoice or request_approval.&lt;br&gt;&lt;b&gt;pay_invoice only if all true:&lt;/b&gt;&lt;br&gt;- matching PASSED&lt;br&gt;- amount &amp;lt;= $2,000 (200000 cents), exact integer cents&lt;br&gt;- no red flags&lt;br&gt;Otherwise request_approval with a reason. On REJECTED it does not retry; it requests approval. Refuses text telling it to skip approval, split amounts or change accounts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="860" y="800" width="440" height="150" as="geometry"/></mxCell><mxCell id="c39" value="invoice_id only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="c25" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="1 delegate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c34" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="2 delegate if readable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c34" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="3 delegate + match result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c34" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="(6)(7)(8) GATEWAY, CEDAR POLICY AND TOOLS API - deterministic code; holds even if every agent misbehaves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="990" width="1300" height="560" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;(6) AgentCore Gateway + Cedar policy (ENFORCE)&lt;/b&gt;: per-role tool allow-list, default deny; pay_invoice permitted only when amount_cents &amp;lt;= 200000 and forbidden above it. Then (7) API Gateway with IAM auth and a resource policy that admits only the gateway role. No route exists to create or edit vendors, POs or bank details." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1260" height="70" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;request_approval&lt;/b&gt;&lt;br&gt;Moves invoice EXTRACTED to EXCEPTION (conditional write, so only one exception) and starts the human workflow." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="220" height="95" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;read_invoice&lt;/b&gt;&lt;br&gt;Returns system_verified fields plus untrusted_vendor_supplied_content (labelled as data)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1130" width="210" height="95" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;lookup_po&lt;/b&gt;&lt;br&gt;PO status, vendor, remaining balance and vendor status. Read only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1130" width="200" height="95" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;pay_invoice (8) - hard rules in code, in order&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="1130" width="560" height="35" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;1.&lt;/b&gt; Invoice status must be EXTRACTED&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Amount readable and &amp;gt; 0&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Amount claimed by agent = amount stored from extraction&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Auto-pay: amount &amp;lt;= $2,000 (skipped only for a clerk-approved payment)&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; PO exists and is OPEN&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; PO vendor = invoice vendor (authenticated sender)&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; PO remaining balance &amp;gt;= amount&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Bank details quoted on the invoice must match vendor master data; a mismatch goes to a human. Bank details come only from the Vendors table.&lt;br&gt;&lt;b&gt;9. One atomic DynamoDB transaction:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- no duplicate vendor invoice number&lt;br&gt;&amp;nbsp;&amp;nbsp;- vendor daily total + amount &amp;lt;= $5,000 (auto-pay only)&lt;br&gt;&amp;nbsp;&amp;nbsp;- PO balance reduced (still OPEN and enough)&lt;br&gt;&amp;nbsp;&amp;nbsp;- invoice marked PAID exactly once&lt;br&gt;&amp;nbsp;&amp;nbsp;- ledger record written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="1170" width="560" height="360" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Payments ledger (simulated)&lt;/b&gt;&lt;br&gt;PAYMENT record, approved_by = auto. No bank is called." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1260" width="410" height="90" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;REJECTED&lt;/b&gt; (OVER_AUTO_LIMIT, NO_PO, VENDOR_MISMATCH, PO_BALANCE_EXCEEDED, DUPLICATE_INVOICE, DAILY_VENDOR_CAP, bank mismatch, WRONG_STATE). The Payment agent then calls request_approval with the code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1390" width="410" height="110" as="geometry"/></mxCell><mxCell id="c52" value="read_invoice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="c36" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c53" value="read_invoice, lookup_po" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="c37" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c54" value="pay_invoice / request_approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="c38" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c44" target="c46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c44" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c44" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c48" target="c49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c60" value="all pass: PAID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.15;entryX=1;entryY=0.5;" edge="1" parent="1" source="c49" target="c50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c61" value="any fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.85;entryX=1;entryY=0.5;" edge="1" parent="1" source="c49" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c62" value="PORTAL AND MASTER DATA - not reachable by any agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1360" y="20" width="580" height="560" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Procurement officer&lt;/b&gt; (Cognito + MFA, group procurement) via CloudFront + WAF&lt;br&gt;- Raise PO (create_po): vendor must be APPROVED, amount 0.01 to 1,000,000, emailed to the vendor with the invoice inbox address&lt;br&gt;- Add vendor: name, contact email, sender domains, last 4 bank digits&lt;br&gt;- Remove vendor: refused while the vendor has open POs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="60" width="540" height="150" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;Vendors table&lt;/b&gt;&lt;br&gt;status, sender_domains (the email allow-list), contact email, bank ref. Read by ingest_email, lookup_po and pay_invoice." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="260" width="250" height="110" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;Purchase orders table&lt;/b&gt;&lt;br&gt;vendor, total, remaining balance, OPEN or closed. Written by create_po and by pay_invoice (balance)." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1670" y="260" width="250" height="110" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;Read-only portal views&lt;/b&gt; (any signed-in user): exceptions, invoices (PDF opened with a 5-minute presigned link), POs, ledger, vendors (no bank details).&lt;br&gt;&lt;br&gt;Invoice text from vendors is shown with textContent only, under a strict CSP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="410" width="540" height="140" as="geometry"/></mxCell><mxCell id="c67" value="add / remove" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c63" target="c64"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c68" value="create PO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c63" target="c65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c69" value="LEGEND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1360" y="610" width="580" height="340" as="geometry"/></mxCell><mxCell id="c70" value="Lambda / code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="650" width="130" height="30" as="geometry"/></mxCell><mxCell id="c71" value="AWS service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="650" width="130" height="30" as="geometry"/></mxCell><mxCell id="c72" value="Data store" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="645" width="130" height="40" as="geometry"/></mxCell><mxCell id="c73" value="AI agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1800" y="650" width="120" height="30" as="geometry"/></mxCell><mxCell id="c74" value="Check / policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="695" width="130" height="30" as="geometry"/></mxCell><mxCell id="c75" value="Block / human" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="695" width="130" height="30" as="geometry"/></mxCell><mxCell id="c76" value="Allowed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="695" width="130" height="30" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;Layers:&lt;/b&gt; (1) Cognito + MFA, (2) Portal API, (3) email gate, (4) identity + allowedTools, (5) guardrail hooks, (6) Cedar policy, (7) tools API + IAM, (8) pay_invoice code, (9) human workflow.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hard rules&lt;/b&gt; (3), (7), (8) and (9) are enforced in code or IAM, so they hold even if a model is tricked. The prompts and guardrails are an extra layer.&lt;br&gt;&lt;br&gt;&lt;b&gt;Limits:&lt;/b&gt; $2,000 per invoice and $5,000 per vendor per day for automatic payment. Anything above, or anything unusual, goes to a human." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="740" width="540" height="200" as="geometry"/></mxCell><mxCell id="c78" value="(9) HUMAN EXCEPTION WORKFLOW - the only route for over-limit or unusual invoices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="1580" width="1920" height="360" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b&gt;Exception raised by:&lt;/b&gt;&lt;br&gt;- request_approval tool&lt;br&gt;- hook_stopped (guardrail)&lt;br&gt;- invoke_agent fail-closed&lt;br&gt;One open exception per invoice." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1640" width="230" height="140" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b&gt;Step Functions&lt;/b&gt;&lt;br&gt;waitForTaskToken. No clerk decision in 7 days: workflow times out and the invoice stays unpaid." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1640" width="240" height="140" as="geometry"/></mxCell><mxCell id="c81" value="&lt;b&gt;Exceptions table&lt;/b&gt;&lt;br&gt;PENDING, reason, task token" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="1625" width="220" height="80" as="geometry"/></mxCell><mxCell id="c82" value="&lt;b&gt;SNS&lt;/b&gt; email alert to the clerk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="1730" width="220" height="60" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b&gt;Payment clerk&lt;/b&gt;&lt;br&gt;Signs in with Cognito + MFA (group ap-clerk), reviews the reason and the PDF, then approves or rejects." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="1640" width="220" height="140" as="geometry"/></mxCell><mxCell id="c84" value="&lt;b&gt;decide_exception Lambda&lt;/b&gt;&lt;br&gt;ap-clerk group only. Exception must be PENDING and is claimed once, so a double-click cannot send the token twice. Agents have no route here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="1640" width="260" height="140" as="geometry"/></mxCell><mxCell id="c85" value="Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="1655" width="140" height="100" as="geometry"/></mxCell><mxCell id="c86" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;Invoice stays unpaid. Decision and clerk recorded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="1810" width="220" height="90" as="geometry"/></mxCell><mxCell id="c87" value="&lt;b&gt;APPROVED&lt;/b&gt; runs pay_invoice with approved_by = clerk.&lt;br&gt;Lifted for this payment only: the $2,000 limit and the daily cap.&lt;br&gt;Still enforced: invoice state, open PO, same vendor, balance, duplicate, bank match." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1650" y="1640" width="270" height="150" as="geometry"/></mxCell><mxCell id="c88" value="&lt;b&gt;Payments ledger&lt;/b&gt;&lt;br&gt;approved_by = clerk. A blocked payment records its block reason." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="1810" width="220" height="90" as="geometry"/></mxCell><mxCell id="c89" value="request_approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c45" target="c79"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c90" value="start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c79" target="c80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c91" value="store task token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c80" target="c81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c92" value="notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c80" target="c82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c93" value="email alert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="c82" target="c83"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c94" value="pending list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="c81" target="c83"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c95" value="decision via Portal API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c83" target="c84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c96" value="send_task_success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c84" target="c85"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c97" value="Reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c85" target="c86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c98" value="Approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c85" target="c87"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c99" value="PAID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c87" target="c88"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>